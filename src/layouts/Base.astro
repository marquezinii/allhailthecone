---
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/cinzel/latin-500.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "../styles/global.css";
import { site } from "../data/universe";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  ["The lore", "/lore"],
  ["The characters", "/characters"],
  ["The world", "/world"],
  ["Gallery", "/gallery"],
  ["Canon", "/canon"],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10131d" />
    <title>{title ? `${title} — ${site.name}` : `${site.name} — A cosmic bureaucracy`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, site.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta
      property="og:title"
      content={title ? `${title} — ${site.name}` : site.name}
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, site.url)} />
    <meta property="og:image" content={`${site.url}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The crowned capybara and the founding figures of Higher Ground."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/json"
      title="Official art catalog"
      href="/art/catalog.json"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="All Hail the Cone — home">
        <img src="/brand/cone-mark.svg" alt="" width="38" height="38" />
        <span>
          ALL HAIL<span>THE CONE</span>
        </span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="main-nav"
        hidden
      >
        Menu <span aria-hidden="true">＋</span>
      </button>
      <nav id="main-nav" aria-label="Main navigation">
        {links.map(([label, href]) => (
          <a
            href={href}
            aria-current={path.startsWith(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <a
        class="header-about"
        href="/about"
        aria-current={path === "/about" ? "page" : undefined}
      >
        The project <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark" href="/">
          <img src="/brand/cone-mark.svg" alt="" width="42" height="42" />
          <span>
            ALL HAIL<span>THE CONE</span>
          </span>
        </a>
        <p>
          Different creatures.
          <br />
          Same inexplicable direction.
        </p>
        <a class="text-link" href="/community">
          Find your place in the cosmos <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer-bottom">
        <span>© 2026 All Hail the Cone</span>
        <nav aria-label="Footer navigation">
          <a href="/about">About</a>
          <a href={site.repo}>GitHub ↗</a>
          <a href="/identity">Identity</a>
          <a href="/privacy">Privacy</a>
          <a href="/canon">Canon v0.1</a>
        </nav>
        <button id="motion-toggle" aria-pressed="false" hidden>
          Pause atmosphere
        </button>
        <span class="footer-motto">THE CONE REMAINS.</span>
      </div>
    </footer>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
