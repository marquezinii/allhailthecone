---
import "@fontsource/cinzel/latin-400.css";
import "@fontsource/cinzel/latin-500.css";
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "../styles/global.css";
import { site } from "../data/universe";
import {
  commonCopy,
  getLocale,
  localeMeta,
  locales,
  localizePath,
  stripLocale,
} from "../i18n";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const locale = getLocale(Astro.url.pathname);
const copy = commonCopy[locale];
const { title, description = copy.description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const basePath = stripLocale(path);
const languagePath = noindex ? "/" : basePath;
---

<!doctype html>
<html lang={localeMeta[locale].html} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10131d" />
    <title>{title ? `${title} — ${site.name}` : `${site.name} — ${copy.defaultTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, site.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta
      property="og:title"
      content={title ? `${title} — ${site.name}` : site.name}
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, site.url)} />
    <meta property="og:locale" content={localeMeta[locale].og} />
    <meta property="og:image" content={`${site.url}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex &&
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={localeMeta[code].html}
          href={new URL(localizePath(basePath, code), site.url)}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(basePath, site.url)}
      />
    )}
    <link
      rel="alternate"
      type="application/json"
      title="Official art catalog"
      href="/art/catalog.json"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.skip}
    </a>
    <header class="site-header">
      <a
        class="wordmark"
        href={localizePath("/", locale)}
        aria-label={copy.homeLabel}
      >
        <img src="/brand/cone-mark.svg" alt="" width="38" height="38" />
        <span>
          ALL HAIL<span>THE CONE</span>
        </span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="main-nav"
        hidden
      >
        {copy.menu} <span aria-hidden="true">＋</span>
      </button>
      <nav id="main-nav" aria-label={copy.navigation}>
        {copy.links.map(([label, href]) => (
          <a
            href={localizePath(href, locale)}
            aria-current={basePath.startsWith(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
        <details class="language-switch">
          <summary aria-label={`${copy.language}: ${localeMeta[locale].name}`}>
            <span class="language-orbit" aria-hidden="true"></span>
            <span>{localeMeta[locale].label}</span>
            <span class="language-chevron" aria-hidden="true"></span>
          </summary>
          <div class="language-menu">
            <span class="language-menu-label">{copy.language}</span>
            {locales.map((code) => (
              <a
                href={localizePath(languagePath, code)}
                lang={localeMeta[code].html}
                hreflang={localeMeta[code].html}
                aria-current={locale === code ? "page" : undefined}
              >
                <span>{localeMeta[code].name}</span>
                <small>{localeMeta[code].label}</small>
              </a>
            ))}
          </div>
        </details>
      </nav>
      <a
        class="header-about"
        href={localizePath("/about", locale)}
        aria-current={basePath === "/about" ? "page" : undefined}
      >
        {copy.project} <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark" href={localizePath("/", locale)}>
          <img src="/brand/cone-mark.svg" alt="" width="42" height="42" />
          <span>
            ALL HAIL<span>THE CONE</span>
          </span>
        </a>
        <p>
          {copy.footerLine.split("\n").map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </p>
        <a class="text-link" href={localizePath("/community", locale)}>
          {copy.community} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer-bottom">
        <span>© 2026 All Hail the Cone</span>
        <nav aria-label={copy.footerNavigation}>
          <a href={localizePath("/about", locale)}>{copy.footerLinks[0]}</a>
          <a href={site.repo}>GitHub ↗</a>
          <a href={site.kofi} target="_blank" rel="noreferrer">
            Ko-fi ↗
          </a>
          <a href={site.buyMeACoffee} target="_blank" rel="noreferrer">
            Buy Me a Coffee ↗
          </a>
          <a
            class="discord-link"
            href={site.discord}
            target="_blank"
            rel="noreferrer"
          >
            <svg class="discord-mark" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M19.54 4.6a16.2 16.2 0 0 0-4.1-1.28l-.5 1.02a15 15 0 0 0-5.86 0l-.5-1.02A16.2 16.2 0 0 0 4.46 4.6C1.87 8.48 1.17 12.26 1.52 15.98a16.4 16.4 0 0 0 5.03 2.53l1.22-1.67a9.4 9.4 0 0 1-1.92-.93l.46-.36c3.7 1.73 7.7 1.73 11.35 0l.46.36a9.3 9.3 0 0 1-1.92.93l1.22 1.67a16.4 16.4 0 0 0 5.03-2.53c.4-4.31-.68-8.06-2.94-11.38ZM8.7 13.7c-1.1 0-2-1-2-2.23s.88-2.23 2-2.23c1.12 0 2.02 1 2 2.23 0 1.23-.88 2.23-2 2.23Zm6.6 0c-1.1 0-2-1-2-2.23s.88-2.23 2-2.23c1.12 0 2.02 1 2 2.23 0 1.23-.88 2.23-2 2.23Z"
              />
            </svg>
            <span>{copy.discord}</span>
          </a>
          <a href={localizePath("/identity", locale)}>{copy.footerLinks[1]}</a>
          <a href={localizePath("/privacy", locale)}>{copy.footerLinks[2]}</a>
          <a href={localizePath("/canon", locale)}>{copy.canon} v0.1</a>
        </nav>
        <button id="motion-toggle" aria-pressed="false" hidden>
          {copy.pause}
        </button>
        <span class="footer-motto">{copy.motto}</span>
        <span class="creator-credit">{copy.creator}</span>
      </div>
    </footer>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
