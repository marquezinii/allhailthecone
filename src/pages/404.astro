---
import Base from "../layouts/Base.astro";
import ConeScene from "../components/ConeScene.astro";
---

<Base
  title="An unfiled destination"
  noindex
  description="This route is not in the current archive. Return to Higher Ground or explore the world atlas."
>
  <section class="wrap character-detail">
    <div>
      <p class="eyebrow">Route 404 · Destination unfiled</p>
      <h1>This island is not on the map.</h1>
      <p>
        The address may have changed, or the record may not exist. The Cone is
        still where you left it.
      </p>
      <div class="profile-links">
        <a class="button button-primary" href="/">
          Return to Higher Ground ↗
        </a>
        <a class="text-link" href="/world">
          Consult the atlas ↗
        </a>
      </div>
    </div>
    <ConeScene compact />
  </section>
</Base>
