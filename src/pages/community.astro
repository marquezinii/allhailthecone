---
import Document from "../layouts/Document.astro";
import { site } from "../data/universe";
import { getLocale } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const copy = {
  en: {
    title: "There is room at the table.",
    label: "The community commons",
    description:
      "Discuss the lore, share a Coneposting experiment, propose a story or help maintain the official archive.",
    start: "A place to begin",
    intro:
      "The community begins in the official GitHub repository. Bring an observation, drawing, story or useful correction. You do not need to know everything to take part.",
    enter: "Enter the discussions",
    discord: "Join the official Discord",
    ways: "Three ways to contribute",
    sections: [
      [
        "Explore the world",
        "Discuss a character, ask about a crossing or offer an interpretation. Label theories as theories.",
      ],
      [
        "Make something",
        "Share a story, image or experiment. Include your sources, how it was made and the permission you hold to submit it.",
      ],
      [
        "Improve the archive",
        "Report broken pages, accessibility barriers and inconsistent records. Propose code and content improvements through a pull request.",
      ],
    ],
    welcome: "Hospitality is a practice",
    conduct:
      "Be kind to people, precise about disagreements and respectful of boundaries. No harassment, hate, impersonation, spam, exposed private information or stolen work.",
    official: "How an idea becomes official",
    review:
      "Maintainers review tone, visual consistency, provenance and effects on existing stories. Acceptance is explicit and recorded; submission alone does not make an idea canon.",
  },
  pt: {
    title: "Há lugar à mesa.",
    label: "O espaço da comunidade",
    description:
      "Discuta a lore, compartilhe um experimento de Coneposting, proponha uma história ou ajude a manter o arquivo oficial.",
    start: "Um lugar para começar",
    intro:
      "A comunidade começa no repositório oficial do GitHub. Traga uma observação, desenho, história ou correção útil. Você não precisa conhecer todo o arquivo para participar.",
    enter: "Entrar nas discussões",
    discord: "Entrar no Discord oficial",
    ways: "Três formas de contribuir",
    sections: [
      [
        "Explore o mundo",
        "Discuta um personagem, pergunte sobre uma travessia ou ofereça uma interpretação. Identifique teorias como teorias.",
      ],
      [
        "Crie algo",
        "Compartilhe uma história, imagem ou experimento. Inclua as fontes, como foi criado e a permissão que você possui para enviá-lo.",
      ],
      [
        "Melhore o arquivo",
        "Reporte páginas quebradas, barreiras de acessibilidade e registros inconsistentes. Proponha melhorias de código e conteúdo por pull request.",
      ],
    ],
    welcome: "Hospitalidade é uma prática",
    conduct:
      "Seja gentil com as pessoas, preciso nas discordâncias e respeitoso com limites. Assédio, ódio, personificação, spam, exposição de dados privados e trabalho roubado não são aceitos.",
    official: "Como uma ideia se torna oficial",
    review:
      "A manutenção avalia tom, consistência visual, proveniência e efeitos sobre histórias existentes. A aceitação é explícita e registrada; o envio por si só não torna uma ideia canônica.",
  },
  zh: {
    title: "桌边仍有位置。",
    label: "社区空间",
    description:
      "讨论世界设定、分享 Coneposting 实验、提出故事，或帮助维护官方档案。",
    start: "从这里开始",
    intro:
      "社区从官方 GitHub 仓库开始。欢迎带来观察、绘画、故事或有效修正。参与并不要求你了解整座档案。",
    enter: "进入讨论区",
    discord: "加入官方 Discord",
    ways: "三种参与方式",
    sections: [
      ["探索世界", "讨论角色、询问某次穿越，或提出诠释。请明确标注理论。"],
      [
        "创作内容",
        "分享故事、图像或实验。请注明来源、制作方式以及你拥有的提交授权。",
      ],
      [
        "完善档案",
        "报告失效页面、无障碍问题和不一致记录。代码与内容改进可通过 pull request 提交。",
      ],
    ],
    welcome: "好客是一种实践",
    conduct:
      "善待他人，准确表达分歧，并尊重界限。禁止骚扰、仇恨、冒充、垃圾信息、泄露私人信息或盗用作品。",
    official: "一个想法如何成为官方内容",
    review:
      "维护者会审查语气、视觉一致性、来源及其对现有故事的影响。接受必须明确记录；提交本身不会使内容成为正史。",
  },
  de: {
    title: "Am Tisch ist noch Platz.",
    label: "Der Gemeinschaftsraum",
    description:
      "Diskutiere die Lore, teile ein Coneposting-Experiment, schlage eine Geschichte vor oder hilf beim offiziellen Archiv.",
    start: "Ein Ort zum Beginnen",
    intro:
      "Die Gemeinschaft beginnt im offiziellen GitHub-Repository. Bring eine Beobachtung, Zeichnung, Geschichte oder nützliche Korrektur mit. Vollständiges Archivwissen ist nicht nötig.",
    enter: "Zu den Diskussionen",
    discord: "Offiziellem Discord beitreten",
    ways: "Drei Arten mitzuwirken",
    sections: [
      [
        "Die Welt erkunden",
        "Diskutiere eine Figur, frage nach einem Übergang oder biete eine Deutung an. Kennzeichne Theorien als solche.",
      ],
      [
        "Etwas erschaffen",
        "Teile eine Geschichte, ein Bild oder Experiment. Nenne Quellen, Entstehungsweise und deine Berechtigung zur Einreichung.",
      ],
      [
        "Das Archiv verbessern",
        "Melde defekte Seiten, Barrieren und widersprüchliche Einträge. Schlage Code- und Inhaltsverbesserungen per Pull Request vor.",
      ],
    ],
    welcome: "Gastfreundschaft ist Praxis",
    conduct:
      "Sei freundlich, präzise bei Meinungsverschiedenheiten und respektiere Grenzen. Belästigung, Hass, Identitätsmissbrauch, Spam, private Daten und gestohlene Werke sind nicht erlaubt.",
    official: "Wie eine Idee offiziell wird",
    review:
      "Die Maintainer prüfen Ton, visuelle Konsistenz, Herkunft und Auswirkungen auf bestehende Geschichten. Annahme wird ausdrücklich festgehalten; eine Einreichung allein wird nicht zum Kanon.",
  },
  fr: {
    title: "Il reste une place à table.",
    label: "L’espace communautaire",
    description:
      "Discutez du récit, partagez une expérience de Coneposting, proposez une histoire ou aidez à maintenir les archives officielles.",
    start: "Un point de départ",
    intro:
      "La communauté commence dans le dépôt GitHub officiel. Apportez une observation, un dessin, une histoire ou une correction utile. Il n’est pas nécessaire de tout connaître pour participer.",
    enter: "Accéder aux discussions",
    discord: "Rejoindre le Discord officiel",
    ways: "Trois façons de contribuer",
    sections: [
      [
        "Explorer le monde",
        "Discutez d’un personnage, posez une question sur une traversée ou proposez une interprétation. Identifiez clairement les théories.",
      ],
      [
        "Créer quelque chose",
        "Partagez une histoire, une image ou une expérience. Indiquez vos sources, la méthode de création et les droits permettant la soumission.",
      ],
      [
        "Améliorer les archives",
        "Signalez pages défectueuses, obstacles d’accessibilité et fiches incohérentes. Proposez les améliorations par pull request.",
      ],
    ],
    welcome: "L’hospitalité est une pratique",
    conduct:
      "Soyez bienveillant, précis dans les désaccords et respectueux des limites. Harcèlement, haine, usurpation, spam, données privées et œuvres volées sont interdits.",
    official: "Comment une idée devient officielle",
    review:
      "Les responsables examinent le ton, la cohérence visuelle, la provenance et l’effet sur les récits existants. L’acceptation est explicite et consignée ; une soumission seule ne devient pas canon.",
  },
}[locale];
---

<Document title={copy.title} label={copy.label} description={copy.description}>
  <h2>{copy.start}</h2>
  <p>{copy.intro}</p>
  <div class="community-actions">
    <a class="button button-primary" href={site.repo + "/discussions"}>
      {copy.enter} ↗
    </a>
    <a
      class="button button-quiet discord-link"
      href={site.discord}
      target="_blank"
      rel="noreferrer"
    >
      <svg class="discord-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M19.54 4.6a16.2 16.2 0 0 0-4.1-1.28l-.5 1.02a15 15 0 0 0-5.86 0l-.5-1.02A16.2 16.2 0 0 0 4.46 4.6C1.87 8.48 1.17 12.26 1.52 15.98a16.4 16.4 0 0 0 5.03 2.53l1.22-1.67a9.4 9.4 0 0 1-1.92-.93l.46-.36c3.7 1.73 7.7 1.73 11.35 0l.46.36a9.3 9.3 0 0 1-1.92.93l1.22 1.67a16.4 16.4 0 0 0 5.03-2.53c.4-4.31-.68-8.06-2.94-11.38ZM8.7 13.7c-1.1 0-2-1-2-2.23s.88-2.23 2-2.23c1.12 0 2.02 1 2 2.23 0 1.23-.88 2.23-2 2.23Zm6.6 0c-1.1 0-2-1-2-2.23s.88-2.23 2-2.23c1.12 0 2.02 1 2 2.23 0 1.23-.88 2.23-2 2.23Z"
        />
      </svg>
      <span>{copy.discord} ↗</span>
    </a>
  </div>
  <h2>{copy.ways}</h2>
  {copy.sections.map(([heading, body]) => (
    <>
      <h3>{heading}</h3>
      <p>{body}</p>
    </>
  ))}
  <h2>{copy.welcome}</h2>
  <p>{copy.conduct}</p>
  <h2>{copy.official}</h2>
  <p>{copy.review}</p>
  <p>
    <a href={site.repo + "/blob/main/CONTRIBUTING.md"}>CONTRIBUTING.md</a> ·{" "}
    <a href={site.repo + "/blob/main/ART_GUIDE.md"}>ART_GUIDE.md</a>
  </p>
</Document>
