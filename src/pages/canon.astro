---
import Document from "../layouts/Document.astro";
import { Content as En } from "../../CANON.md";
import { Content as Pt } from "../content/pt/CANON.md";
import { Content as Zh } from "../content/zh/CANON.md";
import { Content as De } from "../content/de/CANON.md";
import { Content as Fr } from "../content/fr/CANON.md";
import { getLocale } from "../i18n";
import { documentCopy } from "../i18n/content";
const locale = getLocale(Astro.url.pathname);
const Content = { en: En, pt: Pt, zh: Zh, de: De, fr: Fr }[locale];
const [title, label, description] = documentCopy.canon[locale];
---

<Document {title} {label} {description}>
  <Content />
</Document>
