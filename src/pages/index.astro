---
import Base from "../layouts/Base.astro";
import Art from "../components/Art.astro";
import ConeScene from "../components/ConeScene.astro";
import CharacterCard from "../components/CharacterCard.astro";
import { getCharacters, getFragments } from "../i18n/universe";
import { getLocale, localizePath } from "../i18n";
import { homeCopy } from "../i18n/content";
const locale = getLocale(Astro.url.pathname);
const copy = homeCopy[locale];
const characters = getCharacters(locale);
const fragments = getFragments(locale);
const href = (path: string) => localizePath(path, locale);
---

<Base>
  <section
    class="hero"
    aria-labelledby="hero-title"
    data-hero
    data-home-experience
  >
    <div class="hero-art">
      <Art
        id="the-first-observance"
        eager
        sizes="(max-width: 700px) 100vw, 75vw"
      />
      <div class="hero-art-shade"></div>
    </div>
    <div class="hero-orbit" aria-hidden="true"></div>
    <div class="hero-signal" aria-hidden="true">
      <span class="hero-signal-orbit hero-signal-orbit-one"></span>
      <span class="hero-signal-orbit hero-signal-orbit-two"></span>
      <span class="hero-signal-star"></span>
    </div>
    <div class="hero-content wrap">
      <p class="eyebrow hero-eyebrow" data-hero-reveal>
        <span class="status-dot"></span> {copy.heroEyebrow}
      </p>
      <h1 id="hero-title" data-hero-reveal>
        ALL HAIL
        <br />
        THE <span>CONE.</span>
      </h1>
      <p class="hero-description" data-hero-reveal>
        {copy.heroDescription}
      </p>
      <div class="hero-actions" data-hero-reveal>
        <a class="button button-primary" href={href("/lore")}>
          {copy.enter} <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-quiet" href="#the-cone">
          {copy.meetCone} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-note" data-hero-reveal>
        <span class="note-rule"></span>
        <p>
          {copy.note[0]}
          <br />
          {copy.note[1]}
        </p>
      </div>
    </div>
    <div class="hero-bottom">
      <span>{copy.founding}</span>
      <a href="#welcome">
        {copy.scroll} <span aria-hidden="true">↓</span>
      </a>
      <span class="hero-bottom-right">{copy.established}</span>
    </div>
  </section>
  <section id="welcome" class="introduction wrap section-space" data-cinematic>
    <div>
      <p class="eyebrow">{copy.welcome}</p>
      <h2>
        {copy.vast[0]}
        <br />
        {copy.vast[1]}
      </h2>
    </div>
    <div class="intro-copy">
      <p>{copy.intro[0]}</p>
      <p>{copy.intro[1]}</p>
      <p>
        <em>{copy.intro[2]}</em>
      </p>
      <a class="text-link" href={href("/lore")}>
        {copy.orientation} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section
    id="the-cone"
    class="cone-section"
    aria-labelledby="cone-title"
    data-cinematic
  >
    <div class="wrap cone-layout">
      <div class="cone-copy">
        <p class="eyebrow">{copy.coneEyebrow}</p>
        <h2 id="cone-title">
          {copy.coneTitle[0]}
          <br />
          {copy.coneTitle[1]}
          <br />
          <em>{copy.coneTitle[2]}</em>
        </h2>
        <p>
          {copy.coneBody[0]}
          <br />
          {copy.coneBody[1]}
        </p>
        <p>{copy.coneBody[2]}</p>
        <a class="text-link" href={href("/characters/the-sacred-cone")}>
          {copy.regarding} <span aria-hidden="true">↗</span>
        </a>
        <div class="relic-tabs" role="group" aria-label={copy.observations}>
          <button aria-pressed="true" data-observation="object">
            {copy.observationTabs[0]}
          </button>
          <button aria-pressed="false" data-observation="order">
            {copy.observationTabs[1]}
          </button>
          <button aria-pressed="false" data-observation="unknown">
            {copy.observationTabs[2]}
          </button>
        </div>
        <p id="observation-text" class="observation-text" aria-live="polite">
          {copy.observationText[0]}
        </p>
      </div>
      <ConeScene immersive />
    </div>
  </section>
  <section class="wrap section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.administration}</p>
        <h2>
          {copy.beings[0]}
          <br />
          {copy.beings[1]}
        </h2>
      </div>
      <a class="text-link" href={href("/characters")}>
        {copy.meetFigures} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="character-grid">
      {[characters[0], characters[2], characters[3]].map((c) => (
        <CharacterCard character={c} />
      ))}
    </div>
  </section>
  <section class="world-window" aria-labelledby="world-title" data-cinematic>
    <div class="world-image" data-cinematic-art>
      <Art id="an-ordinary-afternoon" sizes="100vw" />
    </div>
    <div class="world-window-shade"></div>
    <div class="world-window-content wrap" data-cinematic-copy>
      <p class="eyebrow">{copy.beyond}</p>
      <h2 id="world-title">
        {copy.roads[0]}
        <br />
        <em>{copy.roads[1]}</em>
      </h2>
      <p>
        {copy.floating[0]}
        <br />
        {copy.floating[1]}
      </p>
      <a class="button button-primary" href={href("/world")}>
        {copy.explore} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <span class="world-coordinate">{copy.fieldRecord}</span>
  </section>
  <section class="wrap section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.fragments}</p>
        <h2>
          {copy.explanation[0]}
          <br />
          {copy.explanation[1]}
        </h2>
      </div>
      <a class="text-link" href={href("/canon")}>
        {copy.consult} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="fragment-grid">
      {fragments.map((f) => (
        <article class="fragment">
          <div class="fragment-meta">
            <span>{f.id}</span>
            <span
              class:list={[
                "status-label",
                { "semi-canon": f.status === "Semi-Canon" },
              ]}
            >
              {f.status}
            </span>
          </div>
          <blockquote>“{f.text}”</blockquote>
          <p>{f.source}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="gallery-teaser wrap" data-cinematic>
    <a href={href("/gallery")} class="gallery-teaser-art" data-cinematic-art>
      <Art id="the-kindness-drift" />
      <span class="image-tag">{copy.collection} ↗</span>
    </a>
    <div data-cinematic-copy>
      <p class="eyebrow">{copy.evidence}</p>
      <h2>
        {copy.picture[0]}
        <br />
        {copy.picture[1]}
      </h2>
      <p>{copy.galleryBody}</p>
      <a class="text-link" href={href("/gallery")}>
        {copy.openGallery} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="invitation wrap section-space">
    <img src="/brand/cone-mark.svg" width="64" height="64" alt="" />
    <p class="eyebrow">{copy.room}</p>
    <h2>
      {copy.stranger[0]}
      <br />
      {copy.stranger[1]}
    </h2>
    <p>
      {copy.invitation[0]}
      <br />
      {copy.invitation[1]}
    </p>
    <a class="button button-primary" href={href("/community")}>
      {copy.join} <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
