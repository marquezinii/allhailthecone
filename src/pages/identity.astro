---
import Base from "../layouts/Base.astro";
import PageHeading from "../components/PageHeading.astro";
import Art from "../components/Art.astro";
import { getLocale, localizePath } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const copy = (
  {
    en: [
      "The identity",
      "Cosmic Violet and Sacred Amber. Explore the official identity studies, ceremonial seals, orbital symbols and design language of All Hail the Cone.",
      "One symbol. Many horizons.",
      "The visual identity",
      "Cosmic Violet. Sacred Amber. A traffic cone elevated by an entire civilization’s attention. The identity follows the universe into every new place.",
      "The two pillars",
      "Higher ground",
      "awaits.",
      "Violet holds the mystery. Amber carries the light. Together, they connect the quiet warmth of a shared cup with the scale of an unknown sky.",
      "Cosmic Violet",
      "Sacred Amber",
      "Ceremonial marks interpret the Cone; they do not replace the orange-and-white object in the founding visual record.",
      "From symbol to system",
      "A coherent constellation.",
      "View the entire collection",
      "Official supplied visual studies. Screen mockups and physical objects show design possibilities; they are not additional products or services currently available.",
    ],
    pt: [
      "A identidade",
      "Violeta Cósmico e Âmbar Sagrado. Explore os estudos oficiais, selos cerimoniais, símbolos orbitais e a linguagem visual de All Hail the Cone.",
      "Um símbolo. Muitos horizontes.",
      "A identidade visual",
      "Violeta Cósmico. Âmbar Sagrado. Um cone de trânsito elevado pela atenção de toda uma civilização. A identidade acompanha o universo a cada novo lugar.",
      "Os dois pilares",
      "Higher ground",
      "aguarda.",
      "O violeta guarda o mistério. O âmbar carrega a luz. Juntos, conectam o calor tranquilo de uma xícara compartilhada à escala de um céu desconhecido.",
      "Violeta Cósmico",
      "Âmbar Sagrado",
      "Marcas cerimoniais interpretam o Cone; elas não substituem o objeto laranja e branco do registro visual fundador.",
      "Do símbolo ao sistema",
      "Uma constelação coerente.",
      "Ver toda a coleção",
      "Estudos visuais oficiais fornecidos. Mockups e objetos físicos mostram possibilidades de design; não são produtos ou serviços disponíveis.",
    ],
    zh: [
      "视觉识别",
      "宇宙紫与神圣琥珀。探索 All Hail the Cone 的官方视觉研究、仪式印记、轨道符号与设计语言。",
      "一个符号，多重地平线。",
      "视觉识别系统",
      "宇宙紫。神圣琥珀。一枚因整个文明的关注而升华的交通锥。视觉识别伴随宇宙抵达每个新地点。",
      "两大支柱",
      "Higher ground",
      "正在等待。",
      "紫色承载神秘，琥珀带来光明。两者将共饮一杯茶的安静温度与未知天空的尺度相连。",
      "宇宙紫",
      "神圣琥珀",
      "仪式标记诠释交通锥，但不会取代创世视觉记录中的橙白色实物。",
      "从符号到系统",
      "一组连贯的星座。",
      "查看完整收藏",
      "用户提供的官方视觉研究。屏幕模型与实体物件展示设计可能，并不代表当前有相关产品或服务。",
    ],
    de: [
      "Die Identität",
      "Kosmisches Violett und Heiliges Bernstein. Entdecke offizielle Studien, zeremonielle Siegel, Orbitalsymbole und die Bildsprache von All Hail the Cone.",
      "Ein Symbol. Viele Horizonte.",
      "Die visuelle Identität",
      "Kosmisches Violett. Heiliges Bernstein. Ein Verkehrskegel, erhoben durch die Aufmerksamkeit einer ganzen Zivilisation. Die Identität begleitet das Universum an jeden neuen Ort.",
      "Die zwei Säulen",
      "Higher ground",
      "wartet.",
      "Violett bewahrt das Geheimnis. Bernstein trägt das Licht. Gemeinsam verbinden sie die Wärme einer geteilten Tasse mit der Weite eines unbekannten Himmels.",
      "Kosmisches Violett",
      "Heiliges Bernstein",
      "Zeremonielle Zeichen deuten den Kegel; sie ersetzen nicht das orange-weiße Objekt der Gründungsaufzeichnung.",
      "Vom Symbol zum System",
      "Eine zusammenhängende Konstellation.",
      "Die gesamte Sammlung ansehen",
      "Offizielle bereitgestellte Bildstudien. Bildschirmmodelle und physische Objekte zeigen Gestaltungsmöglichkeiten; sie sind derzeit keine verfügbaren Produkte oder Dienste.",
    ],
    fr: [
      "L’identité",
      "Violet cosmique et Ambre sacré. Explorez les études officielles, sceaux cérémoniels, symboles orbitaux et le langage visuel de All Hail the Cone.",
      "Un symbole. Plusieurs horizons.",
      "L’identité visuelle",
      "Violet cosmique. Ambre sacré. Un cône de signalisation élevé par l’attention de toute une civilisation. L’identité accompagne l’univers en chaque lieu nouveau.",
      "Les deux piliers",
      "Higher ground",
      "vous attend.",
      "Le violet porte le mystère. L’ambre transporte la lumière. Ensemble, ils relient la chaleur calme d’une tasse partagée à l’échelle d’un ciel inconnu.",
      "Violet cosmique",
      "Ambre sacré",
      "Les marques cérémonielles interprètent le Cône ; elles ne remplacent pas l’objet orange et blanc des archives fondatrices.",
      "Du symbole au système",
      "Une constellation cohérente.",
      "Voir toute la collection",
      "Études visuelles officielles fournies. Les maquettes et objets physiques illustrent des possibilités de conception ; ils ne constituent pas des produits ou services disponibles.",
    ],
  } as const
)[locale];
---

<Base title={copy[0]} description={copy[1]}>
  <PageHeading title={copy[2]} label={copy[3]} description={copy[4]} />
  <section class="identity-intro wrap">
    <div class="identity-crest" data-depth>
      <Art
        id="violet-imperial-crest"
        eager
        sizes="(max-width: 760px) 90vw, 45vw"
      />
    </div>
    <div>
      <p class="eyebrow">{copy[5]}</p>
      <h2>
        {copy[6]}
        <br />
        <em>{copy[7]}</em>
      </h2>
      <p>{copy[8]}</p>
      <div class="colour-pair">
        <div>
          <span class="colour-swatch violet"></span>
          <strong>{copy[9]}</strong>
          <code>#9472D1</code>
        </div>
        <div>
          <span class="colour-swatch amber"></span>
          <strong>{copy[10]}</strong>
          <code>#F2A836</code>
        </div>
      </div>
      <p class="identity-note">{copy[11]}</p>
    </div>
  </section>
  <section class="wrap section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy[12]}</p>
        <h2>{copy[13]}</h2>
      </div>
      <a class="text-link" href={localizePath("/gallery", locale)}>
        {copy[14]} ↗
      </a>
    </div>
    <div class="identity-studies">
      {[
        "brand-foundations",
        "horizontal-identities",
        "vertical-identities",
        "icon-system",
        "monochrome-identities",
        "digital-sanctuary",
        "digital-experience",
        "objects-of-belonging",
      ].map((id) => (
        <a href={localizePath(`/gallery/${id}`, locale)}>
          <Art id={id} sizes="(max-width: 760px) 90vw, 45vw" />
        </a>
      ))}
    </div>
    <p class="identity-note">{copy[15]}</p>
  </section>
</Base>
