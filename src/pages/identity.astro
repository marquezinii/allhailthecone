---
import Base from "../layouts/Base.astro";
import PageHeading from "../components/PageHeading.astro";
import Art from "../components/Art.astro";
---

<Base
  title="The identity"
  description="Cosmic Violet and Sacred Amber. Explore the official identity studies, ceremonial seals, orbital symbols and design language of All Hail the Cone."
>
  <PageHeading
    title="One symbol. Many horizons."
    label="The visual identity"
    description="Cosmic Violet. Sacred Amber. A traffic cone elevated by an entire civilization’s attention. The identity follows the universe into every new place."
  />
  <section class="identity-intro wrap">
    <div class="identity-crest" data-depth>
      <Art
        id="violet-imperial-crest"
        eager
        sizes="(max-width: 760px) 90vw, 45vw"
      />
    </div>
    <div>
      <p class="eyebrow">The two pillars</p>
      <h2>
        Higher ground
        <br />
        <em>awaits.</em>
      </h2>
      <p>
        Violet holds the mystery. Amber carries the light. Together, they
        connect the quiet warmth of a shared cup with the scale of an unknown
        sky.
      </p>
      <div class="colour-pair">
        <div>
          <span class="colour-swatch violet"></span>
          <strong>Cosmic Violet</strong>
          <code>#9472D1</code>
        </div>
        <div>
          <span class="colour-swatch amber"></span>
          <strong>Sacred Amber</strong>
          <code>#F2A836</code>
        </div>
      </div>
      <p class="identity-note">
        Ceremonial marks interpret the Cone; they do not replace the
        orange-and-white object in the founding visual record.
      </p>
    </div>
  </section>
  <section class="wrap section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From symbol to system</p>
        <h2>A coherent constellation.</h2>
      </div>
      <a class="text-link" href="/gallery">
        View the entire collection ↗
      </a>
    </div>
    <div class="identity-studies">
      {[
        "brand-foundations",
        "horizontal-identities",
        "vertical-identities",
        "icon-system",
        "monochrome-identities",
        "digital-sanctuary",
        "digital-experience",
        "objects-of-belonging",
      ].map((id) => (
        <a href={`/gallery/${id}`}>
          <Art id={id} sizes="(max-width: 760px) 90vw, 45vw" />
        </a>
      ))}
    </div>
    <p class="identity-note">
      Official supplied visual studies. Screen mockups and physical objects show
      design possibilities; they are not additional products or services
      currently available.
    </p>
  </section>
</Base>
