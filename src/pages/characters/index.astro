---
import Base from "../../layouts/Base.astro";
import PageHeading from "../../components/PageHeading.astro";
import CharacterCard from "../../components/CharacterCard.astro";
import { characters } from "../../data/universe";
---

<Base
  title="The characters"
  description="Meet The King, The COO, The Banana, The Maestro, the Keepers and the Sacred Cone."
>
  <PageHeading
    title="An unlikely administration."
    label="The figures of Higher Ground"
    description="A sovereign who listens. A pigeon who delivers. A banana who keeps the lights on. No one here finds any of this remarkable."
  />
  <div class="wrap character-grid all-characters">
    {characters.map((c) => (
      <CharacterCard character={c} />
    ))}
  </div>
  <section class="wrap world-dossier">
    <p class="eyebrow">Beyond the inner circle · Semi-Canon</p>
    <h2>The armoured traveller & the quiet witnesses</h2>
    <p>
      In later visual records, an armoured traveller shares tea with The King. A
      crowned duck watches. A cat sleeps through matters of considerable
      importance. Their places in the story are still unfolding.
    </p>
    <a class="text-link" href="/canon">
      Understand their place in the canon ↗
    </a>
  </section>
</Base>
