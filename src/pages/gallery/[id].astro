---
import Base from "../../layouts/Base.astro";
import PageHeading from "../../components/PageHeading.astro";
import Art from "../../components/Art.astro";
import gallery from "../../data/gallery.json";
import { site } from "../../data/universe";
export function getStaticPaths() {
  return gallery.map((art) => ({ params: { id: art.id }, props: { art } }));
}
const { art } = Astro.props;
---

<Base title={art.title} description={art.description}>
  <PageHeading
    title={art.title}
    label={`${art.status} · ${art.category}`}
    description={art.description}
  />
  <div class="wrap">
    <a class="back-link" href="/gallery">
      ← Back to the archive
    </a>
    <div class="art-detail-image">
      <Art id={art.id} eager sizes="90vw" />
    </div>
    <div class="art-detail-info">
      <div>
        <p>
          {art.primary
            ? "The principal canonical visual reference. When later interpretations disagree, this founding image takes precedence."
            : "An official project artwork. Its continuity status is distinct from its place in the official collection."}
        </p>
        <a
          class="text-link"
          href={`${site.repo}/blob/main/assets/originals/${encodeURIComponent(art.source)}`}
        >
          View the preserved original ↗
        </a>
      </div>
      <dl>
        <dt>Record</dt>
        <dd>{art.id}</dd>
        <dt>Canon level</dt>
        <dd>{art.status}</dd>
        <dt>Catalogued</dt>
        <dd>
          <time datetime={art.cataloguedOn}>11 September 2026</time>
        </dd>
        <dt>Characters</dt>
        <dd>{art.characters.join(", ")}</dd>
        <dt>Original files</dt>
        <dd>
          {1 + art.aliases.length}
          {art.aliases.length > 0 ? " · identical copies preserved" : ""}
        </dd>
        <dt>Provenance</dt>
        <dd>
          User-supplied AI-generated artwork. Original files retained without
          edits.
        </dd>
      </dl>
    </div>
  </div>
</Base>
