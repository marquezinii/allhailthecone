---
import Base from "../../layouts/Base.astro";
import PageHeading from "../../components/PageHeading.astro";
import Art from "../../components/Art.astro";
import gallery from "../../data/gallery.json";
import { site } from "../../data/universe";
import { getLocale, localizePath } from "../../i18n";
import { getGalleryArt } from "../../i18n/gallery";
export function getStaticPaths() {
  return gallery.map((art) => ({ params: { id: art.id }, props: { art } }));
}
const { art: sourceArt } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const art = getGalleryArt(sourceArt, locale)!;
const copy = {
  en: [
    "Back to the archive",
    "The principal canonical visual reference. When later interpretations disagree, this founding image takes precedence.",
    "An official project artwork. Its continuity status is distinct from its place in the official collection.",
    "View the preserved original",
    "Record",
    "Canon level",
    "Catalogued",
    "Characters",
    "Original files",
    "identical copies preserved",
    "Provenance",
    "User-supplied AI-generated artwork. Original files retained without edits.",
    "11 September 2026",
  ],
  pt: [
    "Voltar ao arquivo",
    "A principal referência visual canônica. Quando interpretações posteriores discordam, esta imagem fundadora tem precedência.",
    "Uma obra oficial do projeto. Seu status de continuidade é distinto de seu lugar na coleção oficial.",
    "Ver o original preservado",
    "Registro",
    "Nível canônico",
    "Catalogado",
    "Personagens",
    "Arquivos originais",
    "cópias idênticas preservadas",
    "Proveniência",
    "Obra gerada por IA fornecida pelo usuário. Arquivos originais preservados sem alterações.",
    "11 de setembro de 2026",
  ],
  zh: [
    "返回档案",
    "首要的正史视觉参考。若后来的诠释与其冲突，以这幅创世图像为准。",
    "项目官方作品。其连续性状态与其在官方收藏中的位置分别记录。",
    "查看保存的原件",
    "记录",
    "正史级别",
    "收录日期",
    "角色",
    "原始文件",
    "份相同副本已保存",
    "来源",
    "用户提供的 AI 生成作品。原始文件未经修改地保存。",
    "2026 年 9 月 11 日",
  ],
  de: [
    "Zurück zum Archiv",
    "Die wichtigste kanonische Bildreferenz. Bei späteren Widersprüchen hat dieses Gründungsbild Vorrang.",
    "Ein offizielles Projektwerk. Sein Kontinuitätsstatus ist getrennt von seinem Platz in der offiziellen Sammlung.",
    "Erhaltenes Original ansehen",
    "Eintrag",
    "Kanonstufe",
    "Katalogisiert",
    "Figuren",
    "Originaldateien",
    "identische Kopien erhalten",
    "Herkunft",
    "Vom Nutzer bereitgestelltes, KI-generiertes Werk. Originaldateien unverändert erhalten.",
    "11. September 2026",
  ],
  fr: [
    "Retour aux archives",
    "La principale référence visuelle canonique. En cas de désaccord ultérieur, cette image fondatrice prévaut.",
    "Une œuvre officielle du projet. Son statut de continuité est distinct de sa place dans la collection officielle.",
    "Voir l’original préservé",
    "Fiche",
    "Niveau canonique",
    "Catalogué",
    "Personnages",
    "Fichiers originaux",
    "copies identiques préservées",
    "Provenance",
    "Œuvre générée par IA et fournie par l’utilisateur. Fichiers originaux conservés sans modification.",
    "11 septembre 2026",
  ],
}[locale];
---

<Base title={art.title} description={art.description}>
  <PageHeading
    title={art.title}
    label={`${art.status} · ${art.category}`}
    description={art.description}
  />
  <div class="wrap">
    <a class="back-link" href={localizePath("/gallery", locale)}>
      ← {copy[0]}
    </a>
    <div class="art-detail-image">
      <Art id={art.id} eager sizes="90vw" />
    </div>
    <div class="art-detail-info">
      <div>
        <p>{art.primary ? copy[1] : copy[2]}</p>
        <a
          class="text-link"
          href={`${site.repo}/blob/main/assets/originals/${encodeURIComponent(art.source)}`}
        >
          {copy[3]} ↗
        </a>
      </div>
      <dl>
        <dt>{copy[4]}</dt>
        <dd>{art.id}</dd>
        <dt>{copy[5]}</dt>
        <dd>{art.status}</dd>
        <dt>{copy[6]}</dt>
        <dd>
          <time datetime={art.cataloguedOn}>{copy[12]}</time>
        </dd>
        <dt>{copy[7]}</dt>
        <dd>{art.characters.join(", ")}</dd>
        <dt>{copy[8]}</dt>
        <dd>
          {1 + art.aliases.length}
          {art.aliases.length > 0 ? ` · ${copy[9]}` : ""}
        </dd>
        <dt>{copy[10]}</dt>
        <dd>{copy[11]}</dd>
      </dl>
    </div>
  </div>
</Base>
