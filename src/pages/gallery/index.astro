      "Pesquisar no arquivo",
      "Título, personagem ou categoria…",
      "obras no arquivo",
      "obra",
      "A imagem fundadora",
      "Ver obra",
      "Nenhum registro encontrado.",
      "Tente outro título, personagem ou nível de cânone.",
      "Limpar filtros",
    ],
    zh: [
      "视觉档案",
      "All Hail the Cone 的官方作品，从创世肖像到可能的明天。探索收藏及其正史状态。",
      "不可能之事的证据。",
      "视觉档案",
      "图像最先出现，其他一切随之而来。三十一件作品、三十三份保存的原件，以及一个仍在寻找边界的宇宙。",
      "艺术收藏",
      "按正史状态筛选",
      "全部作品",
      "搜索档案",
      "标题、角色或类别…",
      "件档案作品",
      "件作品",
      "创世图像",
      "查看作品",
      "未找到记录。",
      "请尝试其他标题、角色或正史级别。",
      "清除筛选",
    ],
    de: [
      "Das Bildarchiv",
      "Die offiziellen Werke von All Hail the Cone, vom Gründungsporträt bis zu möglichen Zukünften. Entdecke Sammlung und Kanonstatus.",
      "Belege des Unmöglichen.",
      "Das Bildarchiv",
      "Die Bilder kamen zuerst. Alles andere folgte. Einunddreißig Werke, dreiunddreißig erhaltene Originale und ein Universum, das noch seine Grenzen findet.",
      "Kunstsammlung",
      "Nach Kanonstatus filtern",
      "Alle Werke",
      "Archiv durchsuchen",
      "Titel, Figur oder Kategorie…",
      "Werke im Archiv",
      "Werk",
      "Das Gründungsbild",
      "Werk ansehen",
      "Keine Einträge gefunden.",
      "Versuche einen anderen Titel, eine Figur oder Kanonstufe.",
      "Filter löschen",
    ],
    fr: [
      "Les archives visuelles",
      "Les œuvres officielles de All Hail the Cone, du portrait fondateur aux futurs possibles. Explorez la collection et son statut canonique.",
      "Preuves de l’impossible.",
      "Les archives visuelles",
      "Les images sont venues en premier. Tout le reste a suivi. Trente et une œuvres, trente-trois originaux préservés et un univers qui cherche encore ses limites.",
      "Collection d’art",
      "Filtrer par statut canonique",
      "Toutes les œuvres",
      "Rechercher dans les archives",
      "Titre, personnage ou catégorie…",
      "œuvres dans les archives",
      "œuvre",
      "L’image fondatrice",
      "Voir l’œuvre",
      "Aucun document trouvé.",
      "Essayez un autre titre, personnage ou niveau canonique.",
      "Effacer les filtres",
    ],
  } as const
)[locale];
---

<Base title={copy[0]} description={copy[1]}>
  <PageHeading title={copy[2]} label={copy[3]} description={copy[4]} />
  <section
    class="wrap"
    aria-label={copy[5]}
    data-gallery-singular={copy[11]}
    data-gallery-plural={copy[10]}
  >
    <div class="gallery-toolbar" id="gallery-tools" hidden>
      <div class="filter-group" role="group" aria-label={copy[6]}>
        {[
          [copy[7], "all"],
          ["Canon", "Canon"],
          ["Semi-Canon", "Semi-Canon"],
          ["Coneposting", "Coneposting"],
        ].map(([label, value], index) => (
          <button
            data-filter={value}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {label}
          </button>
        ))}
      </div>
      <label class="search-label">
        {copy[8]}
        <input type="search" id="gallery-search" placeholder={copy[9]} />
      </label>
    </div>
    <p id="gallery-count" class="gallery-count" role="status">
      23 {copy[10]}
    </p>
    <div class="gallery-grid">
      {gallery.map((a) => (
        <article
          class="art-card"
          data-status={a.status}
          data-search={`${a.title} ${a.description} ${a.characters.join(" ")} ${a.category}`.toLowerCase()}
        >
          <a class="art-link" href={localizePath(`/gallery/${a.id}`, locale)}>
            <Art id={a.id} />
            <span class="image-tag">{a.primary ? copy[12] : copy[13]} ↗</span>
          </a>
          <div class="art-meta">
            <span class="status-label">{a.status}</span>
            <span>{a.category}</span>
          </div>
          <h2>
            <a href={localizePath(`/gallery/${a.id}`, locale)}>{a.title}</a>
          </h2>
          <p>{a.description}</p>
        </article>
      ))}
    </div>
    <div class="gallery-empty" id="gallery-empty" hidden>
      <h2>{copy[14]}</h2>
      <p>{copy[15]}</p>
      <button class="button button-quiet" id="clear-search">
        {copy[16]}
      </button>
    </div>
  </section>
</Base>
<script>
  const tools = document.querySelector<HTMLElement>("#gallery-tools")!;
  const search = document.querySelector<HTMLInputElement>("#gallery-search")!;
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];
  const cards = [...document.querySelectorAll<HTMLElement>(".art-card")];
  const gallerySection = document.querySelector<HTMLElement>(
    "[data-gallery-plural]",
  )!;
  let filter = "all";
  tools.hidden = false;
  const update = () => {
    const term = search.value.trim().toLowerCase();
    let count = 0;
    for (const card of cards) {
      card.hidden = !(
        (filter === "all" || card.dataset.status === filter) &&
        card.dataset.search!.includes(term)
      );
      if (!card.hidden) count++;
    }
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.filter === filter)),
    );
    document.querySelector("#gallery-count")!.textContent =
      `${count} ${count === 1 ? gallerySection.dataset.gallerySingular : gallerySection.dataset.galleryPlural}`;
    document.querySelector<HTMLElement>("#gallery-empty")!.hidden = count !== 0;
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      filter = b.dataset.filter!;
      update();
    }),
  );
  search.addEventListener("input", update);
  document.querySelector("#clear-search")!.addEventListener("click", () => {
    search.value = "";
    filter = "all";
    update();
    search.focus();
  });
</script>
