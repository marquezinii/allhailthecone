---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<header class="page-heading wrap">
  <p class="eyebrow">
    <span class="small-star" aria-hidden="true">
      ✦
    </span>{" "}
    {label}
  </p>
  <h1>{title}</h1>
  <p class="page-description">{description}</p>
  <div class="heading-rule" aria-hidden="true"></div>
</header>
