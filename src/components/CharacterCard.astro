---
import Art from "./Art.astro";
import { getLocale, localizePath } from "../i18n";
interface Props {
  character: {
    id: string;
    name: string;
    role: string;
    department: string;
    summary: string;
    position: string;
    zoom: number;
    image: string;
  };
}
const { character: c } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<a
  class="character-card"
  href={localizePath(`/characters/${c.id}`, locale)}
  data-depth
>
  <div
    class="character-image"
    style={`--focus: ${c.position}; --zoom: ${c.zoom}`}
  >
    <Art id={c.image} decorative sizes="100vw" />
    <span class="character-department">{c.department}</span>
    <span class="character-open" aria-hidden="true">
      ↗
    </span>
  </div>
  <div class="character-caption">
    <p class="eyebrow">{c.role}</p>
    <h3>{c.name}</h3>
    <p>{c.summary}</p>
  </div>
</a>
